# All variables are read by the Express server (server/src/env.ts).

# Public URL of the app. In development this is the Vite dev server.
APP_URL=http://localhost:5173
# Port for the Express API in development (Vite forwards /api requests to it)
API_PORT=4000
# In production the server listens on PORT (most hosts set this for you), default 4000

# MongoDB
# Local: mongodb://127.0.0.1:27017
# Atlas (free tier works): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hacktrack

# Sessions: a random string of at least 32 characters
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Google sign-in (optional)
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add this Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (verification, password reset, invites, reminders, team updates)
# Without RESEND_API_KEY, or with EMAIL_TRANSPORT=log, emails are printed in the server terminal instead of sent.
# With Resend: verify your domain at https://resend.com/domains and send from an address on it.
RESEND_API_KEY=
EMAIL_FROM=HackTrack <hacktrack@your-domain.com>
# EMAIL_TRANSPORT=log

# Reminder emails: how often the server checks for due reminders (minutes; 0 turns the built-in check off)
REMINDER_INTERVAL_MINUTES=15
# Lets a scheduled job call POST /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# GitHub (optional): projects read their public repository without any setup, at up to 60 requests an hour
# for the whole server. A token (no scopes needed, https://github.com/settings/tokens) raises that to 5,000.
GITHUB_TOKEN=
